# Production Environment Configuration
# Copy this file to .env.prod and fill in your actual values

# Environment
APP_ENV=production
NODE_ENV=production
GO_ENV=production

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-prod-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-prod-google-client-secret

# Strava OAuth Configuration
STRAVA_CLIENT_ID=your-prod-strava-client-id
STRAVA_CLIENT_SECRET=your-prod-strava-client-secret

# Security Secrets
# Generate with: openssl rand -base64 32
JWT_SECRET=your-prod-jwt-secret-change-this

# Generate with: openssl rand -base64 48
ENCRYPTION_SECRET=your-prod-encryption-secret-change-this-min-32-chars

# Email/SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-prod-email@gmail.com
SMTP_PASSWORD=your-prod-app-password
FROM_EMAIL=noreply@academy-sync.com

# Redis Configuration
# If using Terraform Memorystore, this will be auto-generated
# Otherwise, update with your actual Redis instance URL
REDIS_URL=rediss://redis-prod:6379

# Base URLs
# BASE_URL will be auto-generated from Cloud Run backend-api service if deployed via Terraform
# Otherwise, update with your actual production API URL
BASE_URL=https://api.yourdomain.com

# Frontend URL - Update with your actual production frontend URL
FRONTEND_URL=https://yourdomain.com

# Worker Configuration
MAX_WORKERS=50

# Logging
LOG_LEVEL=WARNING

# GCP Configuration
GCP_PROJECT_ID=the-academy-sync-sdlc-test