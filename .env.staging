# Staging Environment Configuration
# Copy this file to .env.staging and fill in your actual values

# Environment
APP_ENV=staging
NODE_ENV=production
GO_ENV=production

# Google OAuth Configuration
GOOGLE_CLIENT_ID=63759334299-tnevhovliqj35dd52unoq2chnnf6828k.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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

# Strava OAuth Configuration
STRAVA_CLIENT_ID=164519
STRAVA_CLIENT_SECRET=e227c4665ef29cca20dd3704a7c242cc666904da

# Security Secrets
# Generate with: openssl rand -base64 32
JWT_SECRET=your-staging-jwt-secret-change-this

# Generate with: openssl rand -base64 48
ENCRYPTION_SECRET=your-staging-encryption-secret-change-this-min-32-chars

# Email/SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-staging-email@gmail.com
SMTP_PASSWORD=your-staging-app-password
FROM_EMAIL=notifications@theacademysync.run

# Redis Configuration
# If using Terraform Memorystore, this will be auto-generated
# Otherwise, update with your actual Redis instance URL
REDIS_URL=redis://redis-staging:6379

# Base URLs
# BASE_URL will be auto-generated from Cloud Run backend-api service if deployed via Terraform
# Otherwise, update with your actual staging API URL
BASE_URL=https://staging-api.theacademysync.run

# Frontend URL - Update with your actual staging frontend URL
FRONTEND_URL=https://staging.theacademysync.run

# Worker Configuration
MAX_WORKERS=10

# Logging
LOG_LEVEL=INFO

# GCP Configuration
GCP_PROJECT_ID=the-academy-sync-sdlc-test