# Staging Environment Configuration
# Copy this file to .env.staging and fill in your actual values

# Environment
APP_ENV=staging
NODE_ENV=production
GO_ENV=production

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-staging-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-staging-google-client-secret

# Strava OAuth Configuration
STRAVA_CLIENT_ID=your-staging-strava-client-id
STRAVA_CLIENT_SECRET=your-staging-strava-client-secret

# Security Secrets
# Generate with: openssl rand -base64 32
JWT_SECRET=your-staging-jwt-secret-change-this

# Generate with: openssl rand -base64 48
ENCRYPTION_SECRET=your-staging-encryption-secret-change-this-min-32-chars

# Email/SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-staging-email@gmail.com
SMTP_PASSWORD=your-staging-app-password
FROM_EMAIL=noreply-staging@academy-sync.com

# Redis Configuration
# Update with your actual Redis instance URL
REDIS_URL=redis://redis-staging:6379

# Base URLs - Update with your actual staging URLs
BASE_URL=https://staging-api.yourdomain.com
FRONTEND_URL=https://staging.yourdomain.com

# Worker Configuration
MAX_WORKERS=10

# Logging
LOG_LEVEL=INFO

# GCP Configuration
GCP_PROJECT_ID=the-academy-sync-sdlc-test