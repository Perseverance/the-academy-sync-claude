// MockProcessingService for testing
type MockProcessingService struct {
	mock.Mock
}

func (m *MockProcessingService) FetchAllTrainingPlanEntries(ctx context.Context, config interface{}, startDate, endDate time.Time) (TrainingPlanCache, error) {
	args := m.Called(ctx, config, startDate, endDate)
	if args.Get(0) == nil {
		return nil, args.Error(1)
	}
	return args.Get(0).(TrainingPlanCache), args.Error(1)
}

func (m *MockProcessingService) ProcessManualRun(ctx context.Context, config interface{}, params interface{}, trainingCache TrainingPlanCache, activitiesCache StravaActivitiesCache) (*ProcessingResult, error) {
	args := m.Called(ctx, config, params, trainingCache, activitiesCache)
	if args.Get(0) == nil {
		return nil, args.Error(1)
	}
	return args.Get(0).(*ProcessingResult), args.Error(1)
}

func (m *MockProcessingService) RunScheduledCycle(ctx context.Context, config interface{}, trainingCache TrainingPlanCache, activitiesCache StravaActivitiesCache) (*ProcessingResult, error) {
	args := m.Called(ctx, config, trainingCache, activitiesCache)
	if args.Get(0) == nil {
		return nil, args.Error(1)
	}
	return args.Get(0).(*ProcessingResult), args.Error(1)
}

// MockUserRepository for testing
type MockUserRepoForWorker struct {
	mock.Mock
}

func (m *MockUserRepoForWorker) GetUser(ctx context.Context, userID int) (*database.User, error) {
	args := m.Called(ctx, userID)
	if args.Get(0) == nil {
		return nil, args.Error(1)
	}
	return args.Get(0).(*database.User), args.Error(1)
}

// MockProcessingLogRepo for testing
type MockProcessingLogRepo struct {
	mock.Mock
}

func (m *MockProcessingLogRepo) CreateActivityLog(ctx context.Context, log *database.ActivityLog) error {
	args := m.Called(ctx, log)
	return args.Error(0)
}

// Test ProcessUserWithData with scheduled trigger
func TestProcessUserWithData_ScheduledTrigger(t *testing.T) {
	// Create mock database
	db, sqlMock, err := sqlmock.New()
	assert.NoError(t, err)
	defer db.Close()

	// Create mocks
	mockProcessingService := new(MockProcessingService)
	mockUserRepo := new(MockUserRepoForWorker)
	mockLogRepo := new(MockProcessingLogRepo)
	
	// Create test user
	spreadsheetID := "test-spreadsheet-id"
	tokenExpiry := time.Now().Add(time.Hour)
	testUser := &database.User{
		ID:                  123,
		Email:               "test@example.com",
		Timezone:            "Europe/Sofia",
		SpreadsheetID:       &spreadsheetID,
		StravaRefreshToken:  []byte("encrypted-token"),
		StravaAccessToken:   []byte("encrypted-access"),
		StravaTokenExpiry:   &tokenExpiry,
		AutomationEnabled:   true,
	}
	
	// Setup user repo mock
	mockUserRepo.On("GetUser", mock.Anything, 123).Return(testUser, nil)
	
	// Setup processing service mock for scheduled run
	processingResult := &ProcessingResult{
		ProcessedDays:   5,
		ActivitiesCount: 3,
		Error:           "",
	}
	mockProcessingService.On("RunScheduledCycle", 
		mock.Anything, 
		mock.Anything, 
		mock.AnythingOfType("TrainingPlanCache"),
		mock.AnythingOfType("StravaActivitiesCache"),
	).Return(processingResult, nil)
	
	// Setup log repo mock
	mockLogRepo.On("CreateActivityLog", mock.Anything, mock.MatchedBy(func(log *database.ActivityLog) bool {
		return log.UserID == 123 &&
			log.ProcessingType == "daily" && // Should be "daily" for scheduled
			log.ProcessingScope == "date_range" &&
			log.Status == "completed" &&
			log.ActivitiesProcessed == 3
	})).Return(nil)
	
	// Create worker
	worker := &Worker{
		db:                db,
		userRepo:          mockUserRepo,
		processingLogRepo: mockLogRepo,
		processingService: mockProcessingService,
		encryptor:         auth.NewEncryptionService("test-key-32-bytes-long!!!!!!!!!!!"),
		logger:            logger.New("test"),
	}
	
	// Create job data with scheduled trigger
	jobData := map[string]interface{}{
		"trigger_type": "scheduled",
		"scheduled_at": time.Now().UTC().Format(time.RFC3339),
	}
	
	// Process the job
	err = worker.ProcessUserWithData(context.Background(), 123, queue.JobTypeScheduledSync, jobData)
	
	// Verify
	assert.NoError(t, err)
	
	// Verify all mocks were called correctly
	mockUserRepo.AssertExpectations(t)
	mockProcessingService.AssertExpectations(t)
	mockLogRepo.AssertExpectations(t)
}

