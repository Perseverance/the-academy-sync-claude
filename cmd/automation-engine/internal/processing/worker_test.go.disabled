// Test ProcessUserWithData error handling - user not found
func TestProcessUserWithData_UserNotFound(t *testing.T) {
	// Create mock database
	db, _, err := sqlmock.New()
	assert.NoError(t, err)
	defer db.Close()

	// Create mocks
	mockProcessingService := new(MockProcessingService)
	mockUserRepo := new(MockUserRepoForWorker)
	mockLogRepo := new(MockProcessingLogRepo)
	
	// Setup user repo mock to return error
	mockUserRepo.On("GetUser", mock.Anything, 404).Return(nil, sql.ErrNoRows)
	
	// Create worker
	worker := &Worker{
		db:                db,
		userRepo:          mockUserRepo,
		processingLogRepo: mockLogRepo,
		processingService: mockProcessingService,
		encryptor:         auth.NewEncryptionService("test-key-32-bytes-long!!!!!!!!!!!"),
		logger:            logger.New("test"),
	}
	
	// Create job data
	jobData := map[string]interface{}{
		"trigger_type": "scheduled",
	}
	
	// Process the job
	err = worker.ProcessUserWithData(context.Background(), 404, queue.JobTypeScheduledSync, jobData)
	
	// Verify error
	assert.Error(t, err)
	assert.Contains(t, err.Error(), "user not found")
	
	// Verify processing service was not called
	mockProcessingService.AssertNotCalled(t, "RunScheduledCycle")
	mockProcessingService.AssertNotCalled(t, "ProcessManualRun")
	
	// Verify log was not created
	mockLogRepo.AssertNotCalled(t, "CreateActivityLog")
}

// Test ProcessUserWithData error handling - processing failure
func TestProcessUserWithData_ProcessingFailure(t *testing.T) {
	// Create mock database
	db, sqlMock, err := sqlmock.New()
	assert.NoError(t, err)
	defer db.Close()

	// Create mocks
	mockProcessingService := new(MockProcessingService)
	mockUserRepo := new(MockUserRepoForWorker)
	mockLogRepo := new(MockProcessingLogRepo)
	
	// Create test user
	testUser := &database.User{
		ID:                  555,
		Email:               "error@example.com",
		Timezone:            "UTC",
		SpreadsheetID:       "error-spreadsheet-id",
		StravaRefreshToken:  "encrypted-token",
		StravaAccessToken:   "encrypted-access",
		StravaTokenExpiry:   time.Now().Add(time.Hour),
		AutomationEnabled:   true,
	}
	
	// Setup user repo mock
	mockUserRepo.On("GetUser", mock.Anything, 555).Return(testUser, nil)
	
	// Setup processing service mock to return error
	processingError := errors.New("strava API rate limit exceeded")
	mockProcessingService.On("RunScheduledCycle", 
		mock.Anything, 
		mock.Anything, 
		mock.AnythingOfType("TrainingPlanCache"),
		mock.AnythingOfType("StravaActivitiesCache"),
	).Return(nil, processingError)
	
	// Setup log repo mock - should create failed log
	mockLogRepo.On("CreateActivityLog", mock.Anything, mock.MatchedBy(func(log *database.ActivityLog) bool {
		return log.UserID == 555 &&
			log.ProcessingType == "daily" &&
			log.Status == "failed" &&
			log.ErrorMessage != nil &&
			*log.ErrorMessage == "strava API rate limit exceeded"
	})).Return(nil)
	
	// Create worker
	worker := &Worker{
		db:                db,
		userRepo:          mockUserRepo,
		processingLogRepo: mockLogRepo,
		processingService: mockProcessingService,
		encryptor:         auth.NewEncryptionService("test-key-32-bytes-long!!!!!!!!!!!"),
		logger:            logger.New("test"),
	}
	
	// Create job data
	jobData := map[string]interface{}{
		"trigger_type": "scheduled",
	}
	
	// Process the job
	err = worker.ProcessUserWithData(context.Background(), 555, queue.JobTypeScheduledSync, jobData)
	
	// Verify error is returned
	assert.Error(t, err)
	assert.Contains(t, err.Error(), "strava API rate limit exceeded")
	
	// Verify all mocks were called correctly
	mockUserRepo.AssertExpectations(t)
	mockProcessingService.AssertExpectations(t)
	mockLogRepo.AssertExpectations(t)
}

// Test job type to processing type mapping
func TestJobTypeToProcessingType(t *testing.T) {
	tests := []struct {
		jobType        string
		triggerType    string
		expectedPType  string
		expectedScope  string
	}{
		{
			jobType:       queue.JobTypeManualSync,
			triggerType:   "manual",
			expectedPType: "manual",
			expectedScope: "date_range",
		},
		{
			jobType:       queue.JobTypeScheduledSync,
			triggerType:   "scheduled",
			expectedPType: "daily",
			expectedScope: "date_range",
		},
		{
			jobType:       "unknown_type",
			triggerType:   "manual",
			expectedPType: "daily", // Default
			expectedScope: "date_range",
		},
	}
	
	for _, tt := range tests {
		t.Run(tt.jobType+"_"+tt.triggerType, func(t *testing.T) {
			// Create mock database
			db, sqlMock, err := sqlmock.New()
			assert.NoError(t, err)
			defer db.Close()

			// Create mocks
			mockProcessingService := new(MockProcessingService)
			mockUserRepo := new(MockUserRepoForWorker)
			mockLogRepo := new(MockProcessingLogRepo)
			
			// Create test user
			testUser := &database.User{
				ID:                  100,
				Email:               "test@example.com",
				Timezone:            "UTC",
				SpreadsheetID:       "test-spreadsheet-id",
				StravaRefreshToken:  "encrypted-token",
				StravaAccessToken:   "encrypted-access",
				StravaTokenExpiry:   time.Now().Add(time.Hour),
				AutomationEnabled:   true,
			}
			
			// Setup user repo mock
			mockUserRepo.On("GetUser", mock.Anything, 100).Return(testUser, nil)
			
			// Setup processing service mock
			processingResult := &ProcessingResult{
				ProcessedDays:   1,
				ActivitiesFound: 0,
				Success:         true,
				Error:           nil,
			}
			
			if tt.triggerType == "scheduled" {
				mockProcessingService.On("RunScheduledCycle", 
					mock.Anything, 
					mock.Anything, 
					mock.AnythingOfType("TrainingPlanCache"),
					mock.AnythingOfType("StravaActivitiesCache"),
				).Return(processingResult, nil)
			} else {
				mockProcessingService.On("ProcessManualRun", 
					mock.Anything, 
					mock.Anything, 
					mock.Anything,
					mock.AnythingOfType("TrainingPlanCache"),
					mock.AnythingOfType("StravaActivitiesCache"),
				).Return(processingResult, nil)
			}
			
			// Setup log repo mock with expected values
			mockLogRepo.On("CreateActivityLog", mock.Anything, mock.MatchedBy(func(log *database.ActivityLog) bool {
				return log.ProcessingType == tt.expectedPType &&
					log.ProcessingScope == tt.expectedScope
			})).Return(nil)
			
			// Create worker
			worker := &Worker{
				db:                db,
				userRepo:          mockUserRepo,
				processingLogRepo: mockLogRepo,
				processingService: mockProcessingService,
				encryptor:         auth.NewEncryptionService("test-key-32-bytes-long!!!!!!!!!!!"),
				logger:            logger.New("test"),
			}
			
			// Create job data
			jobData := map[string]interface{}{
				"trigger_type": tt.triggerType,
			}
			
			// Process the job
			err = worker.ProcessUserWithData(context.Background(), 100, tt.jobType, jobData)
			
			// Verify
			assert.NoError(t, err)
			
			// Verify all mocks were called correctly
			mockUserRepo.AssertExpectations(t)
			mockProcessingService.AssertExpectations(t)
			mockLogRepo.AssertExpectations(t)
		})
	}
}

// Test JSON marshaling of job data
func TestProcessUserWithData_JobDataSerialization(t *testing.T) {
	// Test that job data is properly serialized/deserialized
	jobData := map[string]interface{}{
		"trigger_type": "scheduled",
		"scheduled_at": "2025-01-14T15:00:00Z",
		"params": map[string]interface{}{
			"start_date": "2025-01-01",
			"end_date":   "2025-01-07",
		},
	}
	
	// Marshal to JSON
	jsonData, err := json.Marshal(jobData)
	assert.NoError(t, err)
	
	// Unmarshal back
	var unmarshaled map[string]interface{}
	err = json.Unmarshal(jsonData, &unmarshaled)
	assert.NoError(t, err)
	
	// Verify trigger type
	assert.Equal(t, "scheduled", unmarshaled["trigger_type"])
	
	// Verify scheduled_at
	assert.Equal(t, "2025-01-14T15:00:00Z", unmarshaled["scheduled_at"])
	
	// Verify params
	params, ok := unmarshaled["params"].(map[string]interface{})
	assert.True(t, ok)
	assert.Equal(t, "2025-01-01", params["start_date"])
	assert.Equal(t, "2025-01-07", params["end_date"])
}