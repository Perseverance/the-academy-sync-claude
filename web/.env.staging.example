# Staging Environment Configuration
# Copy this file to .env.staging and update with actual values

# Strava OAuth Configuration
NEXT_PUBLIC_STRAVA_CLIENT_ID=your_staging_strava_client_id

# Google OAuth Configuration (public client ID only)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_staging_google_client_id

# Backend API URL for staging
NEXT_PUBLIC_API_URL=https://api.staging.theacademysync.run

# Add any other staging-specific environment variables here
# NEXT_PUBLIC_FEATURE_FLAG_X=true
# NEXT_PUBLIC_ANALYTICS_ID=your_staging_analytics_id