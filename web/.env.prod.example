# Production Environment Configuration
# Copy this file to .env.prod and update with actual values

# Strava OAuth Configuration
NEXT_PUBLIC_STRAVA_CLIENT_ID=your_production_strava_client_id

# Google OAuth Configuration (public client ID only)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_production_google_client_id

# Backend API URL for production
NEXT_PUBLIC_API_URL=https://api.theacademysync.run

# Add any other production-specific environment variables here
# NEXT_PUBLIC_FEATURE_FLAG_X=false
# NEXT_PUBLIC_ANALYTICS_ID=your_production_analytics_id