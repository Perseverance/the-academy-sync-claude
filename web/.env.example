# Local Development Configuration
# Copy this file to .env for local development

# Strava OAuth Configuration
NEXT_PUBLIC_STRAVA_CLIENT_ID=your_strava_client_id_here

# Google OAuth Configuration (public client ID only)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here

# Backend API URL (for local development)
# Note: This is only used for local development. Production deployments
# use the actual backend API URL configured during build time.
NEXT_PUBLIC_API_URL=http://localhost:8080